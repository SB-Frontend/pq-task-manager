# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Service role key — SERVER ONLY. This bypasses Row Level Security and grants
# full read/write access to the database.
#   * Never prefix it with NEXT_PUBLIC_.
#   * Never commit it.
#   * Find it in Supabase: Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Public self-registration. Set "false" in production: the owner adds accounts
# from Settings > Accounts instead.
#   * false → closed unconditionally, even on an empty database.
#   * true  → open. Emergency/development only, e.g. when no owner account can
#             sign in. Anyone reaching /register could then create an account,
#             and every account sees all data.
#   * unset → closed, unless no account exists yet, so a fresh deployment can be
#             bootstrapped by its first user.
ALLOW_REGISTRATION=false
